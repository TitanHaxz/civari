<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEARBY — SUNUCU GÜVENLİK AYARLARI (Plesk Windows / IIS)
  ========================================================
  Bu dosya sunucuya "her sayfayı şu güvenlik kurallarıyla gönder" der.
  Tarayıcılar bu başlıkları görünce siteyi daha korumalı çalıştırır.

  NE YAPAR?
   1. HTTP ile gelen ziyaretçiyi HTTPS'e (güvenli bağlantıya) yönlendirir.
   2. Tarayıcıya "bu siteye hep HTTPS ile gel" der (HSTS).
   3. Sitenin başka bir sitenin içine gizlice gömülmesini engeller (tıklama hırsızlığı).
   4. Tarayıcının dosya türünü tahmin etmesini kapatır.
   5. Kamera/mikrofon gibi donanımlara erişimi kapatır (konum hariç — harita için gerekli).
   6. Hassas dosyaların (.sql, .md, .ini, db.php) internetten indirilmesini engeller.

  NOT: Sunucun Apache ise bu dosya değil, .htaccess devreye girer.
-->
<configuration>
  <system.webServer>

    <!-- 1) HTTP → HTTPS yönlendirmesi + hassas dosyaları gizleme -->
    <rewrite>
      <rules>
        <rule name="HTTPS Yonlendirme" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <rule name="Hassas Dosyalari Engelle" stopProcessing="true">
          <match url="\.(sql|md|ini|log|bak|old)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <rule name="Veritabani Ayar Dosyasini Engelle" stopProcessing="true">
          <match url="^(db|osm_config)\.php$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
      </rules>
    </rewrite>

    <!-- 2) Güvenlik başlıkları -->
    <httpProtocol>
      <customHeaders>
        <!-- Sunucu bilgisini gizle (saldırganlara ipucu vermemek için) -->
        <remove name="X-Powered-By" />

        <!-- Tarayıcı bu siteye 1 yıl boyunca sadece HTTPS ile bağlansın -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />

        <!-- Site başka bir sayfanın içine çerçeve olarak gömülemez (tıklama hırsızlığı koruması) -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />

        <!-- Tarayıcı dosya türünü tahmin etmesin, sunucunun söylediğine uysun -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- Başka siteye geçerken adres bilgisi sınırlı paylaşılsın -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Donanım erişimleri: konum açık (harita için), kamera/mikrofon/ödeme kapalı -->
        <add name="Permissions-Policy" value="geolocation=(self), camera=(), microphone=(), payment=(), usb=(), magnetometer=()" />

        <!-- İçerik güvenliği: sadece bilinen kaynaklardan kod/görsel yüklenebilir.
             Not: 'unsafe-inline' sayfa içindeki kısa scriptler için gerekli. -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>

    <!-- 3) Klasör içeriğinin listelenmesini kapat -->
    <directoryBrowse enabled="false" />

    <!-- 4) Ayrıntılı hata mesajlarını ziyaretçiye gösterme (bilgi sızdırmasın) -->
    <httpErrors errorMode="Custom" existingResponse="Auto" />

  </system.webServer>
</configuration>
